# URL publique complète du portfolio, sans slash final.
NEXT_PUBLIC_SITE_URL=https://eowinstudio.com

# Docker Compose : port accessible uniquement depuis le VPS.
PORTFOLIO_PORT=3001
# Plafonds en fonctionnement, ajustables sans modifier le code.
PORTFOLIO_CPUS=1.0
PORTFOLIO_MEMORY=512m

# Déploiement manuel uniquement : la CI fournit automatiquement le digest.
